<Window x:Class="Meshatore2D.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meshatore 2D - Quad-Dominant Mesh Generator" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Control Panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="Meshatore 2D" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Polygon Input -->
                <GroupBox Header="1. Define Polygon">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="5">
                            Click on canvas to add points. Right-click to close polygon.
                        </TextBlock>

                        <Button Name="ClearPolygonButton" Content="Clear Polygon" Click="ClearPolygon_Click"/>
                        <Button Name="LoadPresetButton" Content="Load Square Preset" Click="LoadPreset_Click"/>

                        <TextBlock Margin="5,10,5,5">
                            <Run Text="Points: "/>
                            <Run Name="PointCountText" Text="0" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Mesh Parameters -->
                <GroupBox Header="2. Mesh Parameters">
                    <StackPanel>
                        <Label Content="Target Edge Length (0=auto):"/>
                        <TextBox Name="EdgeLengthTextBox" Text="0"/>

                        <Label Content="Quad Quality Threshold (0-1):"/>
                        <Slider Name="QualitySlider" Minimum="0" Maximum="1" Value="0.5"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBlock HorizontalAlignment="Center">
                            <Run Text="Value: "/>
                            <Run Text="{Binding ElementName=QualitySlider, Path=Value, StringFormat=F1}"/>
                        </TextBlock>

                        <Label Content="Smoothing Iterations:"/>
                        <TextBox Name="SmoothingIterationsTextBox" Text="3"/>

                        <CheckBox Name="SmoothTriMeshCheckBox" Content="Smooth Triangle Mesh"
                                  IsChecked="True" Margin="5"/>
                        <CheckBox Name="SmoothFinalMeshCheckBox" Content="Smooth Final Mesh"
                                  IsChecked="True" Margin="5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Generation -->
                <GroupBox Header="3. Generate Mesh">
                    <StackPanel>
                        <Button Name="GenerateMeshButton" Content="Generate Mesh"
                                Click="GenerateMesh_Click" Background="#4CAF50"
                                IsEnabled="False"/>

                        <TextBlock Name="StatusText" TextWrapping="Wrap" Margin="5,10,5,5"
                                   Foreground="#666666" FontStyle="Italic">
                            Define a polygon to start...
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Display Options -->
                <GroupBox Header="4. Display Options">
                    <StackPanel>
                        <CheckBox Name="ShowTrianglesCheckBox" Content="Show Triangles"
                                  IsChecked="True" Checked="UpdateDisplay" Unchecked="UpdateDisplay"
                                  Margin="5"/>
                        <CheckBox Name="ShowQuadsCheckBox" Content="Show Quads"
                                  IsChecked="True" Checked="UpdateDisplay" Unchecked="UpdateDisplay"
                                  Margin="5"/>
                        <CheckBox Name="ShowPolygonCheckBox" Content="Show Polygon"
                                  IsChecked="True" Checked="UpdateDisplay" Unchecked="UpdateDisplay"
                                  Margin="5"/>
                        <CheckBox Name="ShowPointsCheckBox" Content="Show Points"
                                  IsChecked="True" Checked="UpdateDisplay" Unchecked="UpdateDisplay"
                                  Margin="5"/>
                        <CheckBox Name="FillElementsCheckBox" Content="Fill Elements"
                                  IsChecked="False" Checked="UpdateDisplay" Unchecked="UpdateDisplay"
                                  Margin="5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Statistics -->
                <GroupBox Header="5. Statistics">
                    <StackPanel>
                        <TextBlock Name="StatsText" TextWrapping="Wrap" FontFamily="Consolas"
                                   FontSize="11" Margin="5">
                            No mesh generated yet.
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Export -->
                <GroupBox Header="6. Export">
                    <StackPanel>
                        <Button Name="ExportButton" Content="Export Mesh (TXT)"
                                Click="Export_Click" IsEnabled="False"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Canvas Area -->
        <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10">
            <Grid>
                <Canvas Name="MeshCanvas" Background="White"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseRightButtonDown="Canvas_MouseRightButtonDown"
                        MouseMove="Canvas_MouseMove"/>

                <TextBlock Text="Click to add polygon points | Right-click to close polygon"
                           VerticalAlignment="Top" HorizontalAlignment="Center"
                           Margin="0,10,0,0" Foreground="#999999" FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</Window>
